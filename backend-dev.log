      "model": {
        "model": "gpt-4.1",
        "toolIds": [
          "ad5d396f-8cd5-40e9-81b6-928e7a366346",
          "cf991586-c8eb-426a-9e02-4769516e985f",
          "67240cab-693a-4b68-99f2-f4634e160420",
          "f28aee54-be1c-4ae2-b20b-623afbba13ef",
