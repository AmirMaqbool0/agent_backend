NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/clinic_ai_receptionist
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DEBUG_VAPI=false
WEBHOOK_SECRET=change_me
# Set the same value as the Server URL Secret in Vapi to lock down /api/webhooks/vapi
VAPI_WEBHOOK_SECRET=
CLINIC_TIMEZONE=Asia/Karachi
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VAPI_API_KEY=
VAPI_BASE_URL=https://api.vapi.ai
GOOGLE_CALENDAR_AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
WHATSAPP_PROVIDER=web
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved WhatsApp templates (Content SIDs "HX..."). Create them with: npm run whatsapp:templates
# Leave empty to send free-form text (only reaches people who messaged you in the last 24 hours)
TWILIO_TEMPLATE_CONFIRMATION_SID=
TWILIO_TEMPLATE_RESCHEDULE_SID=
TWILIO_TEMPLATE_CANCELLATION_SID=
# Public https URL of this backend (tunnel or deployment); used for Twilio delivery callbacks
PUBLIC_BASE_URL=
FRONTEND_URL=http://localhost:5173
